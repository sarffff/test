#app配置
AGENT_NAME=opus-harness
version=1.0.0

# ===== LLM 对话模型配置（DeepSeek / 通义千问 / 智谱 / OpenAI / 硅基流动 等均可） =====
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_API_KEY=sk-apx53fae9de3dfd690b88c5d2c67d57d7a5909280f3e556147
LLM_MODEL=free/gpt-6-luna
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ===== Embedding 向量模型配置（可与 LLM 不同服务商） =====
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY 留空时自动复用 LLM 的地址与密钥
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 检索参数（可选）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
# 相关性阈值：相似度低于该值的检索结果将被过滤（防幻觉），bge-m3 建议 0.4~0.5
MIN_SCORE=0.45
# 混合检索（BM25 关键词 + 向量，RRF 融合）
HYBRID_SEARCH=true
# 单文件大小上限（MB）
MAX_FILE_SIZE_MB=10
